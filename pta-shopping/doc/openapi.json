          "to" : {
            "$ref" : "#/components/schemas/LocalDate"
          }
        }
      },
      "Violation" : {
        "type" : "object",
        "description" : "Validation constraint violation details",
        "properties" : {
          "field" : {
            "type" : "string",
            "description" : "The field for which the validation failed",
            "examples" : [ "#/profile/email" ]
